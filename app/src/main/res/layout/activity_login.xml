<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:id="@+id/stage_select"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="@string/auth_choose"
                android:textStyle="bold"
                android:textSize="16sp" />

            <RadioGroup
                android:id="@+id/auth_backend_group"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <RadioButton
                    android:id="@+id/radio_ytfixer"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ytfixer"
                    android:textStyle="bold"
                    android:visibility="gone"/>
                <TextView
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="28dp"
                    android:layout_marginBottom="12dp"
                    android:text="@string/ytfixer_desc"
                    android:textSize="12sp"
                    android:textColor="#888888"
                    android:visibility="gone"/>

                <RadioButton
                    android:id="@+id/radio_yt2009"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/yt2009"
                    android:checked="true"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="28dp"
                    android:layout_marginBottom="12dp"
                    android:text="@string/yt2009_desc"
                    android:textSize="12sp"
                    android:textColor="#888888" />
            </RadioGroup>

            <LinearLayout
                android:id="@+id/instance_container"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp">

                <TextView
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/instance"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/instance_warn"/>

                <EditText
                    android:id="@+id/instance_url"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:singleLine="true" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_start_auth"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/auth_start" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/stage_code"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/auth_instructions"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/auth_qr_image"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/auth_url_display"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textColor="#3366CC"
                android:textStyle="bold"
                android:gravity="center"/>

            <TextView
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/auth_code_label"
                android:gravity="center"/>

            <TextView
                android:id="@+id/auth_code_display"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="26sp"
                android:textStyle="bold"
                android:padding="8dp" />

            <Button
                android:id="@+id/btn_check_status"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/auth_check_status" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/auth_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>